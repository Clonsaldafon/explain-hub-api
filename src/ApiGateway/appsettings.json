{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Consul": {
    "Host": "http://consul:8500"
  },
  "ReverseProxy": {
    "Routes": {
      "auth-route": {
        "ClusterId": "auth-cluster",
        "Match": {
          "Path": "/api/v1/auth/{**catch-all}"
        }
      },
      "questions-route": {
        "ClusterId": "qna-cluster",
        "Match": {
          "Path": "/api/v1/questions/{**catch-all}"
        }
      },
      "answers-route": {
        "ClusterId": "qna-cluster",
        "Match": {
          "Path": "/api/v1/answers/{**catch-all}"
        }
      },
      "media-route": {
        "ClusterId": "qna-cluster",
        "Match": {
          "Path": "/api/v1/media/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "auth-cluster": {
        "Destinations": {
          "auth-service": {
            "Address": "http://auth-service:80"
          }
        }
      },
      "qna-cluster": {
        "Destinations": {
          "qna-service": {
            "Address": "http://qna-service:80"
          }
        }
      }
    }
  }
}